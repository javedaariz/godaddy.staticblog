---
import { site, categories, categoryKeys } from '../data/site';
const year = new Date().getFullYear();
const social = Object.entries(site.social).filter(([, v]) => v);
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <h4>{site.name}</h4>
        <p>{site.tagline}. Dated, sourced and answer-first.</p>
      </div>
      <div>
        <h4>Topics</h4>
        {categoryKeys.map((k) => <a href={`/${k}/`}>{categories[k].title}</a>)}
      </div>
      <div>
        <h4>Site</h4>
        <a href="/blog/">All articles</a>
        <a href="/tools/">Free tools</a>
        <a href="/about/">About</a>
        <a href="/editorial-policy/">Editorial policy</a>
        <a href="/contact/">Contact</a>
        <a href="/rss.xml">RSS feed</a>
      </div>
      <div>
        <h4>Legal</h4>
        <a href="/privacy/">Privacy policy</a>
        <a href="/terms/">Terms of use</a>
        <a href="/sitemap/">Sitemap</a>
        {social.map(([k, v]) => <a href={v} rel="me noopener" target="_blank">{k === 'x' ? 'X' : k[0].toUpperCase() + k.slice(1)}</a>)}
      </div>
    </div>
    <p class="copy">© {year} {site.name}. General information only, not financial, tax, legal or medical advice.</p>
  </div>
</footer>
